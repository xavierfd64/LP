// Printing Business Management System — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  STAFF
  PRODUCTION
  CUSTOMER
}

enum InquiryStatus {
  NEW
  QUOTED
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CANCELLED
}

enum PaymentTermType {
  STANDARD_PARTIAL
  APPROVED_TERMS
}

/**
 * Pricing methods a Service can be configured with (spec Part F item 20).
 * NONE means "no automatic pricing" — the honest default for every
 * existing/new Service until Admin explicitly configures one, per item 26
 * ("not every service needs instant quotation") and item 27 ("no price
 * should mean staff review", never an invented price). Architected as an
 * enum specifically so a future pricing method can be added without a
 * schema rewrite (spec: "build the architecture so additional pricing
 * models can be added later").
 */
enum PricingMethod {
  NONE
  PER_PIECE
  FIXED
  PER_SET
  PER_AREA
}

enum OrderStatus {
  OPEN
  IN_PRODUCTION
  FULFILLING
  COMPLETED
  CANCELLED
}

enum JobOrderStatus {
  ON_HOLD
  IN_PROGRESS
  QC
  REWORK
  READY
  RELEASED
  COMPLETED
}

enum StageLogStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

enum FileCategory {
  CUSTOMER_FILE
  DESIGN_DRAFT
  APPROVED_DESIGN
  PRODUCTION_FILE
  QC_EVIDENCE
  PAYMENT_PROOF
  DELIVERY_PROOF
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  MAYA
  CHEQUE
  VOUCHER
  OTHER
}

enum VoucherStatus {
  AVAILABLE
  USED
}

enum QCOutcome {
  PASS
  FAIL
}

enum ReworkStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum MovementType {
  RECEIVE
  ALLOCATE
  CONSUME
  REJECT
  WASTE
  ADJUST
  /// Reverses a purchase's stock increase when cancelled (Aug 20 3rd update) — only ever recorded against a lot with nothing yet consumed from it.
  CANCEL
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
  INSTALLATION
}

enum FulfillmentStatus {
  SCHEDULED
  BOOKED
  IN_TRANSIT
  DELIVERED
  INSTALLED
  RECEIVED
  CANCELLED
}

enum RewardTxnType {
  EARN
  REDEEM
}

// Granular, action-level permissions a STAFF account can be granted. ADMIN
// always bypasses this system entirely; CUSTOMER never participates in it.
// Not every value below has a corresponding enforcement point yet (some are
// defined for schema/preset completeness ahead of features that don't exist
// yet, e.g. order cancellation, payment refunds, customer management) — see
// PROGRESS.md for the full mapping of which permissions actually gate an
// action today.
enum Permission {
  INQUIRY_VIEW
  INQUIRY_HANDLE
  INQUIRY_MODIFY
  INQUIRY_CANCEL

  QUOTATION_VIEW
  QUOTATION_CREATE
  QUOTATION_EDIT
  QUOTATION_SEND
  QUOTATION_HANDLE_MODIFICATION
  QUOTATION_APPROVE_REJECT
  QUOTATION_CANCEL

  ORDER_VIEW
  ORDER_CREATE
  ORDER_MODIFY
  ORDER_HANDLE_MODIFICATION
  ORDER_UPDATE_STATUS
  ORDER_CANCEL

  PAYMENT_VIEW
  PAYMENT_RECORD
  PAYMENT_VERIFY
  PAYMENT_REJECT
  PAYMENT_EDIT
  PAYMENT_REFUND

  PRODUCTION_VIEW
  PRODUCTION_UPDATE_STAGE
  PRODUCTION_MARK_STAGE_COMPLETE
  PRODUCTION_MARK_COMPLETE

  FULFILLMENT_VIEW
  FULFILLMENT_SCHEDULE_PICKUP
  FULFILLMENT_SCHEDULE_DELIVERY
  FULFILLMENT_UPDATE_DELIVERY_STATUS
  FULFILLMENT_MARK_DELIVERED
  FULFILLMENT_MARK_INSTALLED

  REWARDS_VIEW
  REWARDS_PROCESS_REDEMPTION
  REWARDS_MANAGE_CONFIG

  COMMUNICATION_VIEW
  COMMUNICATION_SEND
  COMMUNICATION_MANAGE
  COMMUNICATION_TRANSFER
  COMMUNICATION_ASSIGN
  COMMUNICATION_GROUP
  COMMUNICATION_ATTACHMENT
  COMMUNICATION_REFERENCE_TRANSACTION
  COMMUNICATION_SEARCH_CUSTOMER
  MESSENGER_DISPATCH

  REPORTS_VIEW
  REPORTS_EXPORT

  EXPENSE_VIEW
  EXPENSE_MANAGE
  COST_VIEW

  CUSTOMER_VIEW
  CUSTOMER_CREATE
  CUSTOMER_EDIT
  CUSTOMER_ACTIVATE_DEACTIVATE

  USER_VIEW
  USER_CREATE
  USER_EDIT
  USER_ACTIVATE_DEACTIVATE
  USER_MANAGE_PERMISSIONS

  DOCUMENT_VIEW
  DOCUMENT_SHARE
  DOCUMENT_DOWNLOAD
  DOCUMENT_REVOKE
  ORDER_TRACKING_MANAGE

  SOA_VIEW
  SOA_GENERATE
  SOA_SHARE
  SOA_REVOKE

  EMAIL_LOG_VIEW

  SERVICE_VIEW
  SERVICE_MANAGE

  SUPPLIER_VIEW
  SUPPLIER_MANAGE
  PURCHASE_MANAGE
  INVENTORY_COST_VIEW
}

// ---------- Core ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  /// Null for accounts created via Google/Facebook sign-in that have never
  /// also set a password — they can only sign in through that OAuth provider.
  passwordHash String?
  role         Role
  phone        String?
  active       Boolean   @default(true)
  lastActiveAt DateTime?
  /// Set (and refreshed) whenever this account signs in via that provider —
  /// drives the "Login & Security" connected-methods display. No separate
  /// Account/adapter table (see lib/auth.ts) since email is the only join
  /// key this app needs.
  googleConnectedAt   DateTime?
  facebookConnectedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer         Customer?
  passwordResetTokens PasswordResetToken[]
  stageLogs        JobOrderStageLog[]
  uploadedFiles    File[]
  recordedPayments Payment[]          @relation("PaymentRecordedBy")
  qcResults        QCResult[]
  reworkAssigned   ReworkRecord[]
  inventoryMoves   InventoryMovement[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  sentMessages     Message[]
  quotationsCancelled     Quotation[] @relation("QuotationCancelledBy")
  quotationsForceApproved Quotation[] @relation("QuotationForceApprovedBy")
  quotationsCreated       Quotation[] @relation("QuotationCreatedBy")
  conversationReads       ConversationRead[]
  staffPermissions        StaffPermission[]
  conversationsAssigned   Conversation[]              @relation("ConversationAssignedStaff")
  conversationsCreated    Conversation[]               @relation("ConversationCreatedBy")
  conversationParticipant ConversationParticipant[]
  documentSharesCreated   DocumentShareLink[]
  trackingLinksCreated    OrderTrackingLink[]
  statementsGenerated     StatementOfAccount[]
  adjustmentsCreated      AccountAdjustment[]
  operatingExpensesCreated OperatingExpense[]
  statementSchedulesCreated StatementSchedule[]
  themesInstalled         InstalledTheme[]
  pluginsInstalled        InstalledPlugin[]
  supplyLotsCancelled     SupplyLot[] @relation("SupplyLotCancelledBy")
}

// Existence of a row = granted. Only meaningful for role=STAFF users — ADMIN
// bypasses this system entirely (never checked), CUSTOMER never has rows.
model StaffPermission {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission
  createdAt  DateTime   @default(now())

  @@unique([userId, permission])
}

/// One-time, expiring, single-use token for the email/password Forgot
/// Password flow — also doubles as "set your first password" for an
/// OAuth-only account (passwordHash null), since both are the same
/// underlying operation (spec item 14). Role-agnostic: works for any
/// email/password-capable account, not customer-only.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Customer {
  id                  String   @id @default(cuid())
  displayId           String   @unique
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id])
  name                String
  companyName         String?
  email               String?
  contactNumber       String?
  address             String?
  facebookUrl         String?
  /// Populated from the Google/Facebook profile image on first social
  /// sign-up, only when not already set — never overwrites a value the
  /// customer or Staff set. Display-only on the customer's own My Profile
  /// page; never used for login/sidebar branding (spec item 13).
  profileImageUrl     String?
  isQualifiedForTerms Boolean  @default(false)
  rewardPointsBalance Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inquiries    Inquiry[]
  quotations   Quotation[]
  orders       Order[]
  rewardTxns   RewardTransaction[]
  vouchers     Voucher[]
  quotationRevisionRequests QuotationRevisionRequest[]
  conversations Conversation[]
  statements    StatementOfAccount[]
  adjustments   AccountAdjustment[]
  statementSchedules StatementSchedule[]
  messengerConnection MessengerConnection?
  messengerLogs       MessengerLog[]

  @@index([name])
  @@index([email])
  @@index([contactNumber])
}

model Inquiry {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  description    String
  // Denormalized snapshot of the Service name at the time of entry — never
  // changes even if the Service Master is later renamed (spec: "preserve
  // historical data"). serviceId is the live link, used to drive carry-over
  // and to look up the Service's current production flow at JobOrder time.
  desiredProduct String
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id])
  specs          Json?
  roughQty       Int?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quotations Quotation[]
  conversations Conversation[]
  referencedInMessages Message[]
}

model Quotation {
  id          String          @id @default(cuid())
  inquiryId   String?
  inquiry     Inquiry?        @relation(fields: [inquiryId], references: [id])
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  quoteNumber String          @unique
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  total       Decimal         @default(0) @db.Decimal(12, 2)
  // Discount breakdown, populated when the pricing engine produced this
  // total (instant quotations, spec item 22: "do not silently alter the
  // price" — show the math). Null/0 for ordinary staff-built quotations,
  // where `total` alone (the pre-existing behavior) is still authoritative.
  subtotal      Decimal? @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  discountLabel  String?
  isInstant      Boolean @default(false)
  rejectReason   String?
  notes       String?
  createdById String?
  createdBy   User?    @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  cancelledById   String?
  cancelledBy     User?    @relation("QuotationCancelledBy", fields: [cancelledById], references: [id])
  cancelReason    String?
  approvedByStaffId    String?
  approvedByStaff      User?   @relation("QuotationForceApprovedBy", fields: [approvedByStaffId], references: [id])
  approvalBypassReason String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lineItems        QuotationLineItem[]
  orders           Order[]
  revisionRequests QuotationRevisionRequest[]
  conversations    Conversation[]
  referencedInMessages Message[]
  shareLinks       DocumentShareLink[]
}

model QuotationRevisionRequest {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  message     String
  createdAt   DateTime  @default(now())
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productType String
  serviceId   String?
  service     Service?  @relation(fields: [serviceId], references: [id])
  specs       Json?
  description String
  qty         Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  notes       String?
}

model Order {
  id               String          @id @default(cuid())
  quotationId      String?
  quotation        Quotation?      @relation(fields: [quotationId], references: [id])
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  orderNumber      String          @unique
  status           OrderStatus     @default(OPEN)
  paymentTermType  PaymentTermType @default(STANDARD_PARTIAL)
  termsApprovedBy  String?
  termsReason      String?
  requiredPartialPct Int           @default(50)
  totalAmount      Decimal         @default(0) @db.Decimal(12, 2)
  releaseException Boolean         @default(false)
  releaseExceptionBy String?
  releaseExceptionReason String?
  // Payment due date — optional, set by Staff at order creation (or later).
  // Nothing is ever marked "Overdue" without this being both set AND past,
  // per the SOA spec's explicit rule.
  dueDate          DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  jobOrders    JobOrder[]
  payments     Payment[]
  fulfillments Fulfillment[]
  rewardTxns   RewardTransaction[]
  conversations Conversation[]
  shareLinks    DocumentShareLink[]
  trackingLinks OrderTrackingLink[]
  adjustments   AccountAdjustment[]
}

model WorkflowTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages    WorkflowStage[]
  jobOrders JobOrder[]
  services  Service[]
}

/**
 * The Service/Product Master — the single source of truth for what a
 * customer can request (spec: "Only saved and active services should
 * appear... do not hard-code the options"). Reuses the existing
 * WorkflowTemplate/WorkflowStage models for its configurable production
 * flow rather than inventing a second stage system — a Service just names
 * a WorkflowTemplate as its default flow. `specFields` is an admin-defined
 * list of label strings (e.g. ["Width","Height","Material","Finishing"])
 * rendered as optional key/value inputs wherever this Service is picked;
 * kept as a flat string list rather than a full form-builder schema, which
 * would be a lot of complexity for what the spec actually asks for.
 */
model Service {
  id                 String            @id @default(cuid())
  name               String            @unique
  description        String?
  category           String?
  active             Boolean           @default(true)
  workflowTemplateId String?
  workflowTemplate   WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id])
  specFields         Json              @default("[]")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Pricing configuration (spec Part F/G/I) — all optional/defaulted so
  // every pre-existing Service keeps working exactly as before (no price,
  // no instant quote) until Admin explicitly opts it in. See lib/pricing.ts
  // for how these are actually evaluated.
  pricingMethod       PricingMethod @default(NONE)
  basePrice           Decimal?      @db.Decimal(12, 2)
  minQuantity         Int?
  instantQuoteEnabled Boolean       @default(false)

  // Cost foundation (Aug 20 1st update — Financial Foundation, spec item 7).
  // Deliberately a single flat figure, not yet a BOM breakdown (material/
  // ink/labor/electricity/waste) — that's an explicitly future update (spec
  // item 15). Null means "not configured", which is a distinct state from
  // zero everywhere this is read: lib/service-cost.ts never treats an
  // unconfigured cost as ₱0 (spec item 8's "never invent production costs").
  productionCost Decimal? @db.Decimal(12, 2)

  inquiries  Inquiry[]
  lineItems  QuotationLineItem[]
  jobOrders  JobOrder[]
  pricingTiers Pricelist[]
  promotions   Promotion[]

  @@index([active])
}

/**
 * Bulk/quantity-based pricing (spec Part G item 21) — a per-service list of
 * quantity ranges, each carrying EITHER a flat per-unit override price
 * (the "1-99 = ₱5/pc, 100-499 = ₱4.50/pc" style) OR a percent discount off
 * the base-price subtotal (the "500+ = 5% off" style), never both on the
 * same tier. Named Pricelist rather than PricingTier only to avoid a name
 * collision with the PricingTier TS type exported from lib/pricing.ts.
 */
model Pricelist {
  id              String   @id @default(cuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  minQty          Int
  maxQty          Int?
  pricePerUnit    Decimal? @db.Decimal(12, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  @@index([serviceId])
}

/**
 * Configurable promotional discounts (spec Part H) — deliberately simple
 * (percent OR fixed amount, one applicable Service or all services, an
 * active window, an optional qty range) rather than a rules engine, since
 * that's what the spec actually asks for. lib/pricing.ts picks at most one
 * matching, currently-active promotion per calculation (spec item 25:
 * "never accidentally apply the same discount twice").
 */
model Promotion {
  id              String    @id @default(cuid())
  name            String
  serviceId       String?
  service         Service?  @relation(fields: [serviceId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  minQty          Int?
  maxQty          Int?
  percentDiscount Decimal?  @db.Decimal(5, 2)
  fixedDiscount   Decimal?  @db.Decimal(12, 2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([serviceId])
  @@index([active])
}

model WorkflowStage {
  id           String            @id @default(cuid())
  templateId   String
  template     WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  isQCStage    Boolean           @default(false)
  isInstallStage Boolean         @default(false)

  @@unique([templateId, order])
}

model JobOrder {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  joNumber      String
  productType   String
  serviceId     String?
  service       Service?       @relation(fields: [serviceId], references: [id])
  specs         Json?
  description   String
  quantity      Int
  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  currentStageOrder  Int         @default(1)
  status        JobOrderStatus @default(ON_HOLD)
  deadline      DateTime?
  productionInstructions String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stageLogs     JobOrderStageLog[]
  files         File[]
  qcResults     QCResult[]
  reworkRecords ReworkRecord[]
  inventoryMoves InventoryMovement[]
  fulfillments  Fulfillment[]
  conversations Conversation[]
  referencedInMessages Message[]
  shareLinks    DocumentShareLink[]

  @@unique([orderId, joNumber])
}

model JobOrderStageLog {
  id          String         @id @default(cuid())
  jobOrderId  String
  jobOrder    JobOrder       @relation(fields: [jobOrderId], references: [id])
  stageName   String
  stageOrder  Int
  status      StageLogStatus @default(READY)
  assignedToId String?
  assignedTo  User?          @relation(fields: [assignedToId], references: [id])
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
}

model File {
  id          String       @id @default(cuid())
  jobOrderId  String?
  jobOrder    JobOrder?    @relation(fields: [jobOrderId], references: [id])
  uploadedById String
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  category    FileCategory
  version     Int          @default(1)
  isApproved  Boolean      @default(false)
  filename    String
  path        String
  createdAt   DateTime     @default(now())
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  proofFilePath String?
  voucherId    String?       @unique
  voucher      Voucher?      @relation(fields: [voucherId], references: [id])
  status       PaymentStatus @default(PENDING)
  referenceNumber String?
  paymentDate  DateTime      @default(now())
  recordedById String
  recordedBy   User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime      @default(now())
}

model QCResult {
  id              String     @id @default(cuid())
  jobOrderId      String
  jobOrder        JobOrder   @relation(fields: [jobOrderId], references: [id])
  stageName       String
  inspectorId     String
  inspector       User       @relation(fields: [inspectorId], references: [id])
  result          QCOutcome
  quantityChecked Int
  quantityFailed  Int        @default(0)
  defectNotes     String?
  createdAt       DateTime   @default(now())

  reworkRecord ReworkRecord?
}

model ReworkRecord {
  id                String       @id @default(cuid())
  qcResultId        String       @unique
  qcResult          QCResult     @relation(fields: [qcResultId], references: [id])
  jobOrderId        String
  jobOrder          JobOrder     @relation(fields: [jobOrderId], references: [id])
  defectDescription String
  quantityAffected  Int
  assignedStage     String
  assignedToId      String?
  assignedTo        User?        @relation(fields: [assignedToId], references: [id])
  status            ReworkStatus @default(OPEN)
  reworkQcResultId  String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model InventoryItem {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  unit              String
  reorderThreshold  Int      @default(0)
  currentQty        Int      @default(0)
  createdAt         DateTime @default(now())

  supplyLots SupplyLot[]
}

/**
 * A structured vendor a material purchase can be linked to (Aug 20 3rd
 * update, Part C — replaces free-text supplier names going forward).
 * Never destructively deleted once it has purchase history — see
 * deactivateSupplierAction — only deactivated, so historical purchases
 * always resolve to a real supplier record.
 */
model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxId         String?
  paymentTerms  String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases SupplyLot[]
}

/**
 * A SupplyLot is this system's existing unit of "stock received" — Part C
 * extends it into the unit of "purchase recorded" rather than building a
 * separate purchase table, since receiving material *is* recording a
 * purchase in this business. `unitCost` is nullable (never 0) for a lot
 * whose cost wasn't entered — see lib/inventory-cost.ts, which excludes
 * uncosted lots from the average-cost calculation rather than treating
 * them as free. `supplierName` is the pre-Part-C free-text field, kept
 * verbatim for lots recorded before Supplier existed; new purchases use
 * `supplierId` instead. `cancelledAt` marks a reversed purchase without
 * deleting it — history is never destroyed (spec item 24).
 */
model SupplyLot {
  id              String    @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  lotCode         String    @unique
  receivedDate    DateTime  @default(now())
  receivedQty     Int
  remainingQty    Int
  supplierName    String?
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  unitCost        Decimal?  @db.Decimal(12, 4)
  invoiceNumber   String?
  paymentMethod   PaymentMethod?
  referenceNumber String?
  notes           String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelledBy     User?     @relation("SupplyLotCancelledBy", fields: [cancelledById], references: [id])
  createdAt       DateTime  @default(now())

  movements InventoryMovement[]

  @@index([supplierId])
}

model InventoryMovement {
  id          String       @id @default(cuid())
  supplyLotId String
  supplyLot   SupplyLot    @relation(fields: [supplyLotId], references: [id])
  jobOrderId  String?
  jobOrder    JobOrder?    @relation(fields: [jobOrderId], references: [id])
  type        MovementType
  qty         Int
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  notes       String?
  createdAt   DateTime     @default(now())
}

model Fulfillment {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id])
  jobOrderId        String?
  jobOrder          JobOrder?         @relation(fields: [jobOrderId], references: [id])
  method            FulfillmentMethod
  status            FulfillmentStatus @default(SCHEDULED)
  scheduledDate     DateTime?
  trackingNumber    String?
  courier           String?
  proofFilePath     String?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model RewardRule {
  id                 String   @id @default(cuid())
  name               String
  pointsPerCurrencyUnit Decimal @default(0) @db.Decimal(8, 4)
  currencyUnit       Decimal  @default(100) @db.Decimal(12, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model RewardTransaction {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id])
  points     Int
  type       RewardTxnType
  description String?
  createdAt  DateTime      @default(now())

  voucher Voucher?
}

model RedemptionTier {
  id           String   @id @default(cuid())
  pointsCost   Int
  voucherValue Int
  minimumSpend Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  vouchers Voucher[]
}

model Voucher {
  id     String        @id @default(cuid())
  code   String        @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  tierId String?
  tier   RedemptionTier? @relation(fields: [tierId], references: [id])
  value  Int
  minimumSpend Int
  status VoucherStatus @default(AVAILABLE)
  rewardTransactionId String            @unique
  rewardTransaction   RewardTransaction @relation(fields: [rewardTransactionId], references: [id])
  payment Payment?
  createdAt DateTime @default(now())
}

enum ConversationSubjectType {
  INQUIRY
  QUOTATION
  ORDER
  JOB_ORDER
  GENERAL
}

/**
 * CUSTOMER: a customer + assigned Staff/Admin — ownership/assignment rules
 * apply (see Conversation.assignedStaffId). Covers the per-transaction rows
 * created before this update (subjectType INQUIRY/QUOTATION/ORDER/JOB_ORDER)
 * and the customer's ongoing GENERAL conversation, which is now the primary
 * hub the floating Chatbox drives Staff/Admin toward.
 * CUSTOMER_GROUP: a customer plus multiple Staff/Admin participants, no
 * single-owner lock (see ConversationParticipant).
 * PRIVATE: exactly two Staff/Admin participants (Staff<->Admin).
 * GROUP: an internal multi-participant Staff/Admin room.
 */
enum ConversationType {
  CUSTOMER
  CUSTOMER_GROUP
  PRIVATE
  GROUP
}

enum MessageType {
  TEXT
  SYSTEM
}

enum MessageRefType {
  INQUIRY
  QUOTATION
  JOB_ORDER
}

enum StaffAssignmentMode {
  MANUAL
  AUTOMATIC
  MANUAL_WITH_AUTO_FALLBACK
}

model Conversation {
  id          String                   @id @default(cuid())
  type        ConversationType         @default(CUSTOMER)
  title       String?
  customerId  String?
  customer    Customer?                @relation(fields: [customerId], references: [id])
  subjectType ConversationSubjectType?
  inquiryId   String?
  inquiry     Inquiry?                 @relation(fields: [inquiryId], references: [id])
  quotationId String?
  quotation   Quotation?               @relation(fields: [quotationId], references: [id])
  orderId     String?
  order       Order?                   @relation(fields: [orderId], references: [id])
  jobOrderId  String?
  jobOrder    JobOrder?                @relation(fields: [jobOrderId], references: [id])

  // Ownership: null = unassigned, anyone with COMMUNICATION_VIEW may look but
  // only the assignee may reply once set. Only meaningful for type=CUSTOMER.
  assignedStaffId String?
  assignedStaff   User?     @relation("ConversationAssignedStaff", fields: [assignedStaffId], references: [id])
  assignedAt      DateTime?

  // Drives the 24h no-response reminder sweep — set on every inbound
  // customer message, cleared (implicitly superseded) once Staff replies.
  lastCustomerMessageAt DateTime?
  lastReminderSentAt    DateTime?

  createdById String?
  createdBy   User?    @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
  reads        ConversationRead[]
}

/** Membership for PRIVATE / GROUP / CUSTOMER_GROUP conversations. CUSTOMER conversations don't use this — their two natural parties are customer + assignedStaff (or any Staff/Admin with COMMUNICATION_VIEW for read access). */
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  addedAt        DateTime     @default(now())

  @@unique([conversationId, userId])
}

model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  type           MessageType  @default(TEXT)
  body           String       @default("")

  attachmentPath String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?

  refType        MessageRefType?
  refInquiryId   String?
  refInquiry     Inquiry?        @relation(fields: [refInquiryId], references: [id])
  refQuotationId String?
  refQuotation   Quotation?      @relation(fields: [refQuotationId], references: [id])
  refJobOrderId  String?
  refJobOrder    JobOrder?       @relation(fields: [refJobOrderId], references: [id])

  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())
}

/**
 * Singleton row (always id="default") holding the centralized business
 * identity/branding/contact info admin can edit from Admin -> Business
 * Settings, instead of it being hard-coded across pages. Every field is
 * optional except businessName so the app still renders sensibly before
 * an admin has filled everything in.
 */
model BusinessSettings {
  id String @id @default("default")

  businessName String  @default("LP Printing")
  tagline      String?
  description  String?
  logoPath     String?
  faviconPath  String?

  contactNumber String?
  email         String?
  facebookUrl   String?
  website       String?

  addressLine String?
  city        String?
  province    String?
  postalCode  String?

  assignmentMode StaffAssignmentMode @default(MANUAL)

  // Free-text payment instructions (e.g. GCash/bank account details) shown
  // on the Invoice and Statement of Account documents — no structured
  // "business payment accounts" model exists, and a single editable block
  // covers the actual requirement without inventing one.
  paymentInstructions String?

  // ---------- Centralized Email Notification System ----------
  emailEnabled          Boolean       @default(false)
  emailProvider         EmailProvider?
  emailSenderName       String?
  emailSenderAddress    String?
  emailSmtpHost         String?
  emailSmtpPort         Int?
  emailSmtpSecure       Boolean       @default(true)
  emailSmtpUsername     String?
  // AES-256-GCM encrypted at rest (see lib/email-crypto.ts) — never
  // returned by any read path used client-side, never logged.
  emailSmtpPasswordEnc  String?
  // Per-event overrides: { "PAYMENT_CONFIRMED": false, ... }. A key absent
  // from this map means "on" (the safe default once the master switch and
  // a provider are configured) — see lib/email-events.ts.
  emailEventSettings    Json          @default("{}")
  emailLastTestAt       DateTime?
  emailLastTestOk       Boolean?

  // ---------- Facebook Messenger notifications ----------
  // Real Meta Send-API architecture (lib/messenger.ts): a customer opts in
  // via the documented m.me/<pageId>?ref=<code> deep link, our webhook
  // records their PSID, and sendMessengerEvent() calls the actual Graph API
  // — never a fake "open a Facebook URL" simulation. Functionally inert
  // until Admin supplies a real Page ID + Page Access Token from a
  // registered Meta App; that absence is surfaced honestly (MessengerLog
  // status SKIPPED with a clear reason) rather than pretended away.
  messengerEnabled          Boolean  @default(false)
  messengerPageId           String?
  messengerPageAccessTokenEnc String?
  messengerVerifyToken       String?
  /// HMAC key for verifying the webhook's X-Hub-Signature-256 header against
  /// the raw request body — real Meta App Secret, optional (webhook still
  /// works unverified if unset, same honest-stub tradeoff as the rest of
  /// this integration) but required for a production-grade connection.
  messengerAppSecretEnc      String?
  messengerEventSettings     Json    @default("{}")

  // Customer Google/Facebook sign-in credentials (lib/auth.ts) — an
  // in-app alternative to setting GOOGLE_CLIENT_ID/SECRET and
  // FACEBOOK_CLIENT_ID/SECRET as environment variables. When set here,
  // these take precedence over the env vars; the env vars remain a valid
  // fallback for deployments that prefer not to store OAuth secrets in
  // the database at all. Secrets encrypted at rest exactly like the SMTP
  // password / Messenger Page token above.
  googleClientId             String?
  googleClientSecretEnc      String?
  facebookClientId           String?
  facebookClientSecretEnc    String?

  // ---------- Theme system (Aug 19 1st update) ----------
  // Themes control presentation only — colors/fonts/layout chrome — never
  // business data (spec item 19/48). `activeTheme` is one of the slugs
  // registered in lib/themes.ts ("2026" | "nextgen" today, more once real
  // ZIP-installed themes exist). `themeColorOverrides` is a flat
  // {tokenName: hexValue} map the Admin's Theme Customization page writes
  // to — empty means "use the active theme's own defaults." Applied
  // server-side as CSS custom properties in the root layout, so switching
  // is instant and never touches any other table.
  activeTheme          String  @default("2026")
  themeColorOverrides  Json    @default("{}")
  themeFontFamily      String  @default("montserrat")

  updatedAt DateTime @updatedAt
}

enum EmailProvider {
  GMAIL
  YAHOO
  OUTLOOK
  CUSTOM_SMTP
}

enum DocumentAccessLevel {
  VIEW_ONLY
  VIEW_DOWNLOAD
}

/**
 * A login-free, tokenized public link letting a Customer track a single
 * Order's progress with no account. Deliberately separate from
 * DocumentShareLink below (per spec: two clearly separate systems/permission
 * sets) — this one only ever exposes a read-only progress timeline, never a
 * document. `token` is the sole way to reach the public page (see
 * app/(public)/track/[token]); the numeric/cuid Order id itself is never
 * placed in a public URL.
 */
model OrderTrackingLink {
  id        String    @id @default(cuid())
  token     String    @unique
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  createdById String
  createdBy User      @relation(fields: [createdById], references: [id])
  expiresAt DateTime?
  revokedAt DateTime?
  viewCount    Int      @default(0)
  lastViewedAt DateTime?
  createdAt DateTime  @default(now())
}

/**
 * A login-free, tokenized public link to view (and optionally download) one
 * specific Quotation, Invoice (=Order), or Job Order document. Exactly one
 * of quotationId/orderId/jobOrderId is set, mirroring how Message's
 * refQuotationId/refOrderId-via-refJobOrderId reference columns already work
 * in this schema. accessLevel is enforced server-side when the public page
 * renders and again before the PDF/print route serves a response — never
 * just a hidden frontend button.
 */
model DocumentShareLink {
  id          String              @id @default(cuid())
  token       String              @unique
  quotationId String?
  quotation   Quotation?          @relation(fields: [quotationId], references: [id])
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id])
  jobOrderId  String?
  jobOrder    JobOrder?           @relation(fields: [jobOrderId], references: [id])
  statementId String?
  statement   StatementOfAccount? @relation(fields: [statementId], references: [id])
  accessLevel DocumentAccessLevel @default(VIEW_ONLY)
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  expiresAt   DateTime?
  revokedAt   DateTime?
  viewCount        Int       @default(0)
  lastViewedAt     DateTime?
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  createdAt   DateTime  @default(now())
}

enum AccountAdjustmentType {
  CHARGE
  CREDIT
}

/**
 * Admin-extensible expense categories (Aug 20 1st update — Financial
 * Foundation, spec item 3: "flexible enough to allow Admin to create
 * additional expense categories"). A real table rather than an enum
 * specifically so Admin can add one without a code change — the same
 * reasoning already used for the Service Master over a hardcoded product
 * list. `active` lets a category be retired without breaking historical
 * expense records that reference it.
 */
/**
 * `active` controls whether a category is offered on the *new* expense
 * form (spec Part B item 8) — it never affects existing OperatingExpense
 * rows, which keep their categoryId/relation regardless. Deletion is only
 * permitted for a category with zero linked expenses (see
 * deleteExpenseCategoryAction); one with history can only be deactivated,
 * never destroyed (Part B item 6).
 */
model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  expenses OperatingExpense[]
}

/**
 * Business overhead (rent, utilities, salaries, ...) — distinct from
 * Production Cost/COGS (Service.productionCost), never mixed together in
 * any calculation (spec item 13's explicit accounting distinction).
 * `paymentMethod` reuses the existing PaymentMethod enum rather than a
 * parallel one, since it's the same real-world set of choices.
 */
model OperatingExpense {
  id              String          @id @default(cuid())
  expenseNumber   String          @unique
  expenseDate     DateTime
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  description     String
  payee           String?
  amount          Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  notes           String?
  createdById     String?
  createdBy       User?           @relation(fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([expenseDate])
  @@index([categoryId])
}

/**
 * A manual credit or charge against a Customer's account balance — e.g. a
 * goodwill credit, a write-off, or a correction — factored into
 * lib/soa.ts's Statement of Account computation alongside real Orders/
 * Payments. Optionally tied to one Order for context; the balance impact
 * is always customer-level.
 */
model AccountAdjustment {
  id          String                @id @default(cuid())
  customerId  String
  customer    Customer              @relation(fields: [customerId], references: [id])
  orderId     String?
  order       Order?                @relation(fields: [orderId], references: [id])
  type        AccountAdjustmentType
  amount      Decimal               @db.Decimal(12, 2)
  description String
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id])
  createdAt   DateTime              @default(now())
}

/**
 * A generated Statement of Account is a persisted snapshot (statement
 * number + period + the four summary totals) so a previously-issued
 * statement stays stable for history/audit even as new transactions land —
 * but the actual transaction-by-transaction breakdown table is always
 * recomputed live from Order/Payment/AccountAdjustment records within
 * [periodStart, periodEnd) at render time (see lib/soa.ts), never stored
 * separately, per the spec's "use existing financial records as the
 * source of truth, do not create a separate calculation system."
 */
model StatementOfAccount {
  id                 String    @id @default(cuid())
  statementNumber    String    @unique
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id])
  periodStart        DateTime
  periodEnd          DateTime
  openingBalance     Decimal   @db.Decimal(12, 2)
  totalCharges       Decimal   @db.Decimal(12, 2)
  totalPayments      Decimal   @db.Decimal(12, 2)
  adjustments        Decimal   @default(0) @db.Decimal(12, 2)
  outstandingBalance Decimal   @db.Decimal(12, 2)
  generatedById      String?
  generatedBy        User?     @relation(fields: [generatedById], references: [id])
  generatedAt        DateTime  @default(now())

  shareLinks DocumentShareLink[]
}

enum StatementDeliveryMethod {
  EMAIL
}

/**
 * Admin-configured recurring SOA schedule for one customer — structure to
 * support automation (spec: "Future SOA Automation"), never fires on its
 * own until explicitly enabled. Swept the same opportunistic way as the
 * existing 24h chat-response reminder (lib/response-reminders.ts): a
 * debounced check on SSE connect, plus a dedicated cron route for anyone
 * wiring up a real external scheduler.
 */
model StatementSchedule {
  id                String                   @id @default(cuid())
  customerId        String
  customer          Customer                 @relation(fields: [customerId], references: [id])
  dayOfMonth        Int                      @default(1)
  deliveryMethod    StatementDeliveryMethod  @default(EMAIL)
  onlyIfOutstanding Boolean                  @default(true)
  enabled           Boolean                  @default(false)
  createdById       String
  createdBy         User                     @relation(fields: [createdById], references: [id])
  lastRunAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

/**
 * Doubles as the email queue and the email log (spec explicitly wants
 * both): a row is created QUEUED the instant an event fires, then updated
 * in place as it's attempted — there's no separate queue table to keep in
 * sync. See lib/email.ts.
 */
model EmailLog {
  id             String      @id @default(cuid())
  recipientEmail String
  subject        String
  bodyHtml       String      @default("")
  eventType      String
  relatedType    String?
  relatedId      String?
  status         EmailStatus @default(QUEUED)
  failureReason  String?
  attemptCount   Int         @default(0)
  createdAt      DateTime    @default(now())
  sentAt         DateTime?
}

/**
 * Admin-editable subject/body per email event key, with {{variable}}
 * placeholders (see lib/email-events.ts for the canonical key list and
 * default content). A missing row for a given key just means "use the
 * built-in default" — Admin only needs to create a row to override one.
 */
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt
}

/**
 * One customer's Messenger opt-in state. `optinRef` is the unique code
 * embedded in their m.me/<pageId>?ref=<optinRef> link before they connect;
 * once our webhook sees that ref come back in a message's referral
 * payload, `psid` (the page-scoped Messenger user id) and `connected` are
 * set. Never messaged before `connected` is true — the spec is explicit
 * that customers must affirmatively authorize the channel.
 */
model MessengerConnection {
  id          String    @id @default(cuid())
  customerId  String    @unique
  customer    Customer  @relation(fields: [customerId], references: [id])
  optinRef    String    @unique
  psid        String?
  connected   Boolean   @default(false)
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
}

enum MessengerStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

/** Mirrors EmailLog's shape/role (queue + log in one table) for the Messenger channel. */
model MessengerLog {
  id            String          @id @default(cuid())
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  message       String
  eventType     String
  relatedType   String?
  relatedId     String?
  status        MessengerStatus @default(QUEUED)
  failureReason String?
  createdAt     DateTime        @default(now())
  sentAt        DateTime?
}

/**
 * A theme installed from a ZIP upload (Aug 19 1st update, Part D) —
 * distinct from the two built-in themes ("2026"/"nextgen" registered in
 * lib/themes.ts), which ship compiled into the app and need no DB row.
 * This table is the persistent record of what was uploaded; the actual
 * extracted files live under /themes/<slug> on disk, which — like every
 * other upload in this app (Business Settings logo, chat attachments) —
 * does not survive a redeploy on this host's ephemeral filesystem. A
 * newly-uploaded theme is validated and listed here, but activating it
 * only flips `BusinessSettings.activeTheme`; rendering an arbitrary
 * uploaded theme's own components is out of scope for this update (see
 * PROGRESS.md) — only the two compiled-in themes can actually be activated
 * today, matching spec item 43's instruction not to pretend more exists
 * than actually does.
 */
model InstalledTheme {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     String
  author      String?
  description String?
  installedAt DateTime @default(now())
  installedById String?
  installedBy   User?  @relation(fields: [installedById], references: [id])
}

/**
 * A plugin installed from a ZIP upload (Part F). Same persistence/ephemeral-
 * filesystem caveat as InstalledTheme above. `active` is a real, persisted
 * toggle Admin controls from /admin/plugins — deliberately just state, since
 * this update prepares the plugin *architecture* (spec item 38 explicitly:
 * do not build an actual payment gateway or other real functionality here).
 */
model InstalledPlugin {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     String
  author      String?
  description String?
  active      Boolean  @default(false)
  installedAt DateTime @default(now())
  installedById String?
  installedBy   User?  @relation(fields: [installedById], references: [id])
}
