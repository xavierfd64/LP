// Printing Business Management System — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  STAFF
  PRODUCTION
  CUSTOMER
}

enum InquiryStatus {
  NEW
  QUOTED
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CANCELLED
}

enum PaymentTermType {
  STANDARD_PARTIAL
  APPROVED_TERMS
}

enum OrderStatus {
  OPEN
  IN_PRODUCTION
  FULFILLING
  COMPLETED
  CANCELLED
}

enum JobOrderStatus {
  ON_HOLD
  IN_PROGRESS
  QC
  REWORK
  READY
  RELEASED
  COMPLETED
}

enum StageLogStatus {
  READY
  IN_PROGRESS
  COMPLETED
}

enum FileCategory {
  CUSTOMER_FILE
  DESIGN_DRAFT
  APPROVED_DESIGN
  PRODUCTION_FILE
  QC_EVIDENCE
  PAYMENT_PROOF
  DELIVERY_PROOF
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  MAYA
  CHEQUE
  VOUCHER
  OTHER
}

enum VoucherStatus {
  AVAILABLE
  USED
}

enum QCOutcome {
  PASS
  FAIL
}

enum ReworkStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum MovementType {
  RECEIVE
  ALLOCATE
  CONSUME
  REJECT
  WASTE
  ADJUST
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
  INSTALLATION
}

enum FulfillmentStatus {
  SCHEDULED
  BOOKED
  IN_TRANSIT
  DELIVERED
  INSTALLED
  RECEIVED
  CANCELLED
}

enum RewardTxnType {
  EARN
  REDEEM
}

// Granular, action-level permissions a STAFF account can be granted. ADMIN
// always bypasses this system entirely; CUSTOMER never participates in it.
// Not every value below has a corresponding enforcement point yet (some are
// defined for schema/preset completeness ahead of features that don't exist
// yet, e.g. order cancellation, payment refunds, customer management) — see
// PROGRESS.md for the full mapping of which permissions actually gate an
// action today.
enum Permission {
  INQUIRY_VIEW
  INQUIRY_HANDLE
  INQUIRY_MODIFY
  INQUIRY_CANCEL

  QUOTATION_VIEW
  QUOTATION_CREATE
  QUOTATION_EDIT
  QUOTATION_SEND
  QUOTATION_HANDLE_MODIFICATION
  QUOTATION_APPROVE_REJECT
  QUOTATION_CANCEL

  ORDER_VIEW
  ORDER_CREATE
  ORDER_MODIFY
  ORDER_HANDLE_MODIFICATION
  ORDER_UPDATE_STATUS
  ORDER_CANCEL

  PAYMENT_VIEW
  PAYMENT_RECORD
  PAYMENT_VERIFY
  PAYMENT_REJECT
  PAYMENT_EDIT
  PAYMENT_REFUND

  PRODUCTION_VIEW
  PRODUCTION_UPDATE_STAGE
  PRODUCTION_MARK_STAGE_COMPLETE
  PRODUCTION_MARK_COMPLETE

  FULFILLMENT_VIEW
  FULFILLMENT_SCHEDULE_PICKUP
  FULFILLMENT_SCHEDULE_DELIVERY
  FULFILLMENT_UPDATE_DELIVERY_STATUS
  FULFILLMENT_MARK_DELIVERED
  FULFILLMENT_MARK_INSTALLED

  REWARDS_VIEW
  REWARDS_PROCESS_REDEMPTION
  REWARDS_MANAGE_CONFIG

  COMMUNICATION_VIEW
  COMMUNICATION_SEND
  COMMUNICATION_MANAGE
  COMMUNICATION_TRANSFER
  COMMUNICATION_ASSIGN
  COMMUNICATION_GROUP
  COMMUNICATION_ATTACHMENT
  COMMUNICATION_REFERENCE_TRANSACTION
  COMMUNICATION_SEARCH_CUSTOMER

  REPORTS_VIEW
  REPORTS_EXPORT

  CUSTOMER_VIEW
  CUSTOMER_CREATE
  CUSTOMER_EDIT
  CUSTOMER_ACTIVATE_DEACTIVATE

  USER_VIEW
  USER_CREATE
  USER_EDIT
  USER_ACTIVATE_DEACTIVATE
  USER_MANAGE_PERMISSIONS

  DOCUMENT_VIEW
  DOCUMENT_SHARE
  DOCUMENT_DOWNLOAD
  DOCUMENT_REVOKE
  ORDER_TRACKING_MANAGE
}

// ---------- Core ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  phone        String?
  active       Boolean   @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer         Customer?
  stageLogs        JobOrderStageLog[]
  uploadedFiles    File[]
  recordedPayments Payment[]          @relation("PaymentRecordedBy")
  qcResults        QCResult[]
  reworkAssigned   ReworkRecord[]
  inventoryMoves   InventoryMovement[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  sentMessages     Message[]
  quotationsCancelled     Quotation[] @relation("QuotationCancelledBy")
  quotationsForceApproved Quotation[] @relation("QuotationForceApprovedBy")
  quotationsCreated       Quotation[] @relation("QuotationCreatedBy")
  conversationReads       ConversationRead[]
  staffPermissions        StaffPermission[]
  conversationsAssigned   Conversation[]              @relation("ConversationAssignedStaff")
  conversationsCreated    Conversation[]               @relation("ConversationCreatedBy")
  conversationParticipant ConversationParticipant[]
  documentSharesCreated   DocumentShareLink[]
  trackingLinksCreated    OrderTrackingLink[]
}

// Existence of a row = granted. Only meaningful for role=STAFF users — ADMIN
// bypasses this system entirely (never checked), CUSTOMER never has rows.
model StaffPermission {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission
  createdAt  DateTime   @default(now())

  @@unique([userId, permission])
}

model Customer {
  id                  String   @id @default(cuid())
  displayId           String   @unique
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id])
  name                String
  companyName         String?
  email               String?
  contactNumber       String?
  address             String?
  facebookUrl         String?
  isQualifiedForTerms Boolean  @default(false)
  rewardPointsBalance Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inquiries    Inquiry[]
  quotations   Quotation[]
  orders       Order[]
  rewardTxns   RewardTransaction[]
  vouchers     Voucher[]
  quotationRevisionRequests QuotationRevisionRequest[]
  conversations Conversation[]

  @@index([name])
  @@index([email])
  @@index([contactNumber])
}

model Inquiry {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  description    String
  desiredProduct String
  roughQty       Int?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quotations Quotation[]
  conversations Conversation[]
  referencedInMessages Message[]
}

model Quotation {
  id          String          @id @default(cuid())
  inquiryId   String?
  inquiry     Inquiry?        @relation(fields: [inquiryId], references: [id])
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  quoteNumber String          @unique
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  total       Decimal         @default(0) @db.Decimal(12, 2)
  notes       String?
  createdById String?
  createdBy   User?    @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  cancelledById   String?
  cancelledBy     User?    @relation("QuotationCancelledBy", fields: [cancelledById], references: [id])
  cancelReason    String?
  approvedByStaffId    String?
  approvedByStaff      User?   @relation("QuotationForceApprovedBy", fields: [approvedByStaffId], references: [id])
  approvalBypassReason String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lineItems        QuotationLineItem[]
  orders           Order[]
  revisionRequests QuotationRevisionRequest[]
  conversations    Conversation[]
  referencedInMessages Message[]
  shareLinks       DocumentShareLink[]
}

model QuotationRevisionRequest {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  message     String
  createdAt   DateTime  @default(now())
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productType String
  description String
  qty         Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  notes       String?
}

model Order {
  id               String          @id @default(cuid())
  quotationId      String?
  quotation        Quotation?      @relation(fields: [quotationId], references: [id])
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  orderNumber      String          @unique
  status           OrderStatus     @default(OPEN)
  paymentTermType  PaymentTermType @default(STANDARD_PARTIAL)
  termsApprovedBy  String?
  termsReason      String?
  requiredPartialPct Int           @default(50)
  totalAmount      Decimal         @default(0) @db.Decimal(12, 2)
  releaseException Boolean         @default(false)
  releaseExceptionBy String?
  releaseExceptionReason String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  jobOrders    JobOrder[]
  payments     Payment[]
  fulfillments Fulfillment[]
  rewardTxns   RewardTransaction[]
  conversations Conversation[]
  shareLinks    DocumentShareLink[]
  trackingLinks OrderTrackingLink[]
}

model WorkflowTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages    WorkflowStage[]
  jobOrders JobOrder[]
}

model WorkflowStage {
  id           String            @id @default(cuid())
  templateId   String
  template     WorkflowTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  isQCStage    Boolean           @default(false)
  isInstallStage Boolean         @default(false)

  @@unique([templateId, order])
}

model JobOrder {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  joNumber      String
  productType   String
  description   String
  quantity      Int
  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  currentStageOrder  Int         @default(1)
  status        JobOrderStatus @default(ON_HOLD)
  deadline      DateTime?
  productionInstructions String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stageLogs     JobOrderStageLog[]
  files         File[]
  qcResults     QCResult[]
  reworkRecords ReworkRecord[]
  inventoryMoves InventoryMovement[]
  fulfillments  Fulfillment[]
  conversations Conversation[]
  referencedInMessages Message[]
  shareLinks    DocumentShareLink[]

  @@unique([orderId, joNumber])
}

model JobOrderStageLog {
  id          String         @id @default(cuid())
  jobOrderId  String
  jobOrder    JobOrder       @relation(fields: [jobOrderId], references: [id])
  stageName   String
  stageOrder  Int
  status      StageLogStatus @default(READY)
  assignedToId String?
  assignedTo  User?          @relation(fields: [assignedToId], references: [id])
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
}

model File {
  id          String       @id @default(cuid())
  jobOrderId  String?
  jobOrder    JobOrder?    @relation(fields: [jobOrderId], references: [id])
  uploadedById String
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  category    FileCategory
  version     Int          @default(1)
  isApproved  Boolean      @default(false)
  filename    String
  path        String
  createdAt   DateTime     @default(now())
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  proofFilePath String?
  voucherId    String?       @unique
  voucher      Voucher?      @relation(fields: [voucherId], references: [id])
  status       PaymentStatus @default(PENDING)
  referenceNumber String?
  paymentDate  DateTime      @default(now())
  recordedById String
  recordedBy   User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime      @default(now())
}

model QCResult {
  id              String     @id @default(cuid())
  jobOrderId      String
  jobOrder        JobOrder   @relation(fields: [jobOrderId], references: [id])
  stageName       String
  inspectorId     String
  inspector       User       @relation(fields: [inspectorId], references: [id])
  result          QCOutcome
  quantityChecked Int
  quantityFailed  Int        @default(0)
  defectNotes     String?
  createdAt       DateTime   @default(now())

  reworkRecord ReworkRecord?
}

model ReworkRecord {
  id                String       @id @default(cuid())
  qcResultId        String       @unique
  qcResult          QCResult     @relation(fields: [qcResultId], references: [id])
  jobOrderId        String
  jobOrder          JobOrder     @relation(fields: [jobOrderId], references: [id])
  defectDescription String
  quantityAffected  Int
  assignedStage     String
  assignedToId      String?
  assignedTo        User?        @relation(fields: [assignedToId], references: [id])
  status            ReworkStatus @default(OPEN)
  reworkQcResultId  String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model InventoryItem {
  id                String   @id @default(cuid())
  sku               String   @unique
  name              String
  unit              String
  reorderThreshold  Int      @default(0)
  currentQty        Int      @default(0)
  createdAt         DateTime @default(now())

  supplyLots SupplyLot[]
}

model SupplyLot {
  id              String   @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  lotCode         String   @unique
  receivedDate    DateTime @default(now())
  receivedQty     Int
  remainingQty    Int
  supplier        String?
  createdAt       DateTime @default(now())

  movements InventoryMovement[]
}

model InventoryMovement {
  id          String       @id @default(cuid())
  supplyLotId String
  supplyLot   SupplyLot    @relation(fields: [supplyLotId], references: [id])
  jobOrderId  String?
  jobOrder    JobOrder?    @relation(fields: [jobOrderId], references: [id])
  type        MovementType
  qty         Int
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  notes       String?
  createdAt   DateTime     @default(now())
}

model Fulfillment {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id])
  jobOrderId        String?
  jobOrder          JobOrder?         @relation(fields: [jobOrderId], references: [id])
  method            FulfillmentMethod
  status            FulfillmentStatus @default(SCHEDULED)
  scheduledDate     DateTime?
  trackingNumber    String?
  courier           String?
  proofFilePath     String?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model RewardRule {
  id                 String   @id @default(cuid())
  name               String
  pointsPerCurrencyUnit Decimal @default(0) @db.Decimal(8, 4)
  currencyUnit       Decimal  @default(100) @db.Decimal(12, 2)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model RewardTransaction {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id])
  points     Int
  type       RewardTxnType
  description String?
  createdAt  DateTime      @default(now())

  voucher Voucher?
}

model RedemptionTier {
  id           String   @id @default(cuid())
  pointsCost   Int
  voucherValue Int
  minimumSpend Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  vouchers Voucher[]
}

model Voucher {
  id     String        @id @default(cuid())
  code   String        @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  tierId String?
  tier   RedemptionTier? @relation(fields: [tierId], references: [id])
  value  Int
  minimumSpend Int
  status VoucherStatus @default(AVAILABLE)
  rewardTransactionId String            @unique
  rewardTransaction   RewardTransaction @relation(fields: [rewardTransactionId], references: [id])
  payment Payment?
  createdAt DateTime @default(now())
}

enum ConversationSubjectType {
  INQUIRY
  QUOTATION
  ORDER
  JOB_ORDER
  GENERAL
}

/**
 * CUSTOMER: a customer + assigned Staff/Admin — ownership/assignment rules
 * apply (see Conversation.assignedStaffId). Covers the per-transaction rows
 * created before this update (subjectType INQUIRY/QUOTATION/ORDER/JOB_ORDER)
 * and the customer's ongoing GENERAL conversation, which is now the primary
 * hub the floating Chatbox drives Staff/Admin toward.
 * CUSTOMER_GROUP: a customer plus multiple Staff/Admin participants, no
 * single-owner lock (see ConversationParticipant).
 * PRIVATE: exactly two Staff/Admin participants (Staff<->Admin).
 * GROUP: an internal multi-participant Staff/Admin room.
 */
enum ConversationType {
  CUSTOMER
  CUSTOMER_GROUP
  PRIVATE
  GROUP
}

enum MessageType {
  TEXT
  SYSTEM
}

enum MessageRefType {
  INQUIRY
  QUOTATION
  JOB_ORDER
}

enum StaffAssignmentMode {
  MANUAL
  AUTOMATIC
  MANUAL_WITH_AUTO_FALLBACK
}

model Conversation {
  id          String                   @id @default(cuid())
  type        ConversationType         @default(CUSTOMER)
  title       String?
  customerId  String?
  customer    Customer?                @relation(fields: [customerId], references: [id])
  subjectType ConversationSubjectType?
  inquiryId   String?
  inquiry     Inquiry?                 @relation(fields: [inquiryId], references: [id])
  quotationId String?
  quotation   Quotation?               @relation(fields: [quotationId], references: [id])
  orderId     String?
  order       Order?                   @relation(fields: [orderId], references: [id])
  jobOrderId  String?
  jobOrder    JobOrder?                @relation(fields: [jobOrderId], references: [id])

  // Ownership: null = unassigned, anyone with COMMUNICATION_VIEW may look but
  // only the assignee may reply once set. Only meaningful for type=CUSTOMER.
  assignedStaffId String?
  assignedStaff   User?     @relation("ConversationAssignedStaff", fields: [assignedStaffId], references: [id])
  assignedAt      DateTime?

  // Drives the 24h no-response reminder sweep — set on every inbound
  // customer message, cleared (implicitly superseded) once Staff replies.
  lastCustomerMessageAt DateTime?
  lastReminderSentAt    DateTime?

  createdById String?
  createdBy   User?    @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
  reads        ConversationRead[]
}

/** Membership for PRIVATE / GROUP / CUSTOMER_GROUP conversations. CUSTOMER conversations don't use this — their two natural parties are customer + assignedStaff (or any Staff/Admin with COMMUNICATION_VIEW for read access). */
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  addedAt        DateTime     @default(now())

  @@unique([conversationId, userId])
}

model ConversationRead {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  type           MessageType  @default(TEXT)
  body           String       @default("")

  attachmentPath String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?

  refType        MessageRefType?
  refInquiryId   String?
  refInquiry     Inquiry?        @relation(fields: [refInquiryId], references: [id])
  refQuotationId String?
  refQuotation   Quotation?      @relation(fields: [refQuotationId], references: [id])
  refJobOrderId  String?
  refJobOrder    JobOrder?       @relation(fields: [refJobOrderId], references: [id])

  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())
}

/**
 * Singleton row (always id="default") holding the centralized business
 * identity/branding/contact info admin can edit from Admin -> Business
 * Settings, instead of it being hard-coded across pages. Every field is
 * optional except businessName so the app still renders sensibly before
 * an admin has filled everything in.
 */
model BusinessSettings {
  id String @id @default("default")

  businessName String  @default("LP Printing")
  tagline      String?
  description  String?
  logoPath     String?
  faviconPath  String?

  contactNumber String?
  email         String?
  facebookUrl   String?
  website       String?

  addressLine String?
  city        String?
  province    String?
  postalCode  String?

  assignmentMode StaffAssignmentMode @default(MANUAL)

  updatedAt DateTime @updatedAt
}

enum DocumentAccessLevel {
  VIEW_ONLY
  VIEW_DOWNLOAD
}

/**
 * A login-free, tokenized public link letting a Customer track a single
 * Order's progress with no account. Deliberately separate from
 * DocumentShareLink below (per spec: two clearly separate systems/permission
 * sets) — this one only ever exposes a read-only progress timeline, never a
 * document. `token` is the sole way to reach the public page (see
 * app/(public)/track/[token]); the numeric/cuid Order id itself is never
 * placed in a public URL.
 */
model OrderTrackingLink {
  id        String    @id @default(cuid())
  token     String    @unique
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id])
  createdById String
  createdBy User      @relation(fields: [createdById], references: [id])
  expiresAt DateTime?
  revokedAt DateTime?
  viewCount    Int      @default(0)
  lastViewedAt DateTime?
  createdAt DateTime  @default(now())
}

/**
 * A login-free, tokenized public link to view (and optionally download) one
 * specific Quotation, Invoice (=Order), or Job Order document. Exactly one
 * of quotationId/orderId/jobOrderId is set, mirroring how Message's
 * refQuotationId/refOrderId-via-refJobOrderId reference columns already work
 * in this schema. accessLevel is enforced server-side when the public page
 * renders and again before the PDF/print route serves a response — never
 * just a hidden frontend button.
 */
model DocumentShareLink {
  id          String              @id @default(cuid())
  token       String              @unique
  quotationId String?
  quotation   Quotation?          @relation(fields: [quotationId], references: [id])
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id])
  jobOrderId  String?
  jobOrder    JobOrder?           @relation(fields: [jobOrderId], references: [id])
  accessLevel DocumentAccessLevel @default(VIEW_ONLY)
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  expiresAt   DateTime?
  revokedAt   DateTime?
  viewCount        Int       @default(0)
  lastViewedAt     DateTime?
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  createdAt   DateTime  @default(now())
}
