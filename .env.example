DATABASE_URL="postgresql://postgres:postgres@localhost:5432/printbiz?schema=public"
NEXTAUTH_SECRET="dev-secret-change-in-production-please"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="dev-secret-change-in-production-please"

# Required to run `npx prisma db seed` / `npm run db:seed` at all — this is
# a deliberate, explicit opt-in (not just NODE_ENV-based) so the demo
# admin/staff/customer accounts (all password "password123", see
# prisma/seed.ts) can never be created by accident. Set to "true" for local
# development only. NEVER set this in a production environment's variables.
RUN_SEED="true"

# Optional: enables GET /api/cron/response-reminders for an external scheduler
# to trigger the 24h chat response-reminder sweep on a precise cadence. Not
# required — the sweep also runs opportunistically off SSE connections.
# CRON_SECRET="change-me"

# Optional: secure environment-based Gmail credentials. When set, and the
# Gmail provider is selected in Admin -> Email Settings, these are used
# directly instead of a password stored (encrypted) in Business Settings —
# the App Password never needs to be typed into any form. Generate the App
# Password at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification on the Google account). Never commit real values here.
# EMAIL_GMAIL_ADDRESS="you@gmail.com"
# EMAIL_GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional: customer Google/Facebook sign-in (lib/auth.ts). Both providers
# only register — and their "Continue with..." buttons only appear on
# /login and /register — once their pair of credentials below is fully
# set; leave them unset (or comment out) to run with plain email/password
# only. Use a SEPARATE app/set of credentials per environment (dev vs.
# staging vs. production) — never share one OAuth app's Client Secret
# across environments. Register redirect URIs as:
#   <your deployed URL>/api/auth/callback/google
#   <your deployed URL>/api/auth/callback/facebook
# Google: https://console.cloud.google.com/apis/credentials
# Facebook: https://developers.facebook.com/apps (Facebook Login product)
# Never commit real values here.
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="xxxx"
# FACEBOOK_CLIENT_ID="xxxx"
# FACEBOOK_CLIENT_SECRET="xxxx"
